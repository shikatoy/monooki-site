<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.monooki.daily-check</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"$HOME/Documents/monooki-site/tools/product-check.sh"</string>
  </array>

  <!-- 毎朝 8:00。変更が見つからなければ何もせずに終わる -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Mac がスリープなどで 8:00 を逃した場合、起動後に一度だけ実行する -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/monooki-daily.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/monooki-daily.err</string>
</dict>
</plist>
